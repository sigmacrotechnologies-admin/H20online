# ─── Local development (default) ───────────────────────────────────────────
# Use your PC's LAN IP so Expo Go / dev client on phone can reach local backend.
# Run: npm run local   (auto-detects IP and starts Expo)
#
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000

# ─── Test AWS API in Expo (without rebuilding APK) ─────────────────────────
# Run: npm run prod:local
#
# EXPO_PUBLIC_API_URL=http://13.62.57.255:5000

# ─── Production APK ────────────────────────────────────────────────────────
# URL is set in eas.json at build time (not this file).
# Run: npm run build:apk
# Change IP in: config/apiUrl.json + eas.json

# Google Maps — required for address pin picker, distance & tracking on mobile.
# Use the same key as backend GOOGLE_MAPS_API_KEY. Enable: Maps JavaScript API,
# Geocoding API, Maps SDK for Android, Maps SDK for iOS, Static Maps API.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

EXPO_PUBLIC_API_URL=http://YOUR_PC_IP:5000
