# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT — copy to mobile/.env
# Or run: npm run local  (auto-detects your PC Wi-Fi IP)
# ═══════════════════════════════════════════════════════════════════════════

# Your PC LAN IP — phone must be on same Wi-Fi (run ipconfig on Windows)
EXPO_PUBLIC_API_URL=http://192.168.1.2:5000

# Android emulator only:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Test AWS production API from Expo Go (no APK rebuild):
# npm run prod:local
# EXPO_PUBLIC_API_URL=http://13.62.57.255:5000

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Production APK URL is set in eas.json + config/apiUrl.json (not this file)
