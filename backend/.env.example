# ═══════════════════════════════════════════════════════════════════════════
# H2O Online — BACKEND environment template
# ═══════════════════════════════════════════════════════════════════════════
#
# LOCAL (PC + Atlas DB):
#   cp .env.local.example .env
#   NODE_ENV=development
#
# PRODUCTION (AWS EC2):
#   cp .env.production.example .env   (on server only — never commit .env)
#   NODE_ENV=production
#
# AWS production API: http://13.62.57.255:5000  (see config/aws-production.json)
# ═══════════════════════════════════════════════════════════════════════════

# --- Local defaults (see .env.local.example for full local template) ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/H20online?retryWrites=true&w=majority
JWT_SECRET=your-secret-key-change-in-production

MASTER_ADMIN_EMAIL=H2O admin
MASTER_ADMIN_PASSWORD=admin@H2O

# Required only when NODE_ENV=production:
# ALLOWED_ORIGINS=http://13.62.57.255:3000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
