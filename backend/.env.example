# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (production) — Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/H20online?retryWrites=true&w=majority

# Auth — use a long random string in production (openssl rand -hex 32)
JWT_SECRET=your-secret-key-change-in-production

# Admin master login (change in production)
MASTER_ADMIN_EMAIL=H2O admin
MASTER_ADMIN_PASSWORD=admin@H2O

# CORS — comma-separated browser origins (required when NODE_ENV=production)
# AWS EC2 example (admin on :3000, API on :5000):
ALLOWED_ORIGINS=http://13.62.57.255:3000
# With custom domain later:
# ALLOWED_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com

# Optional: path to built admin SPA (serve from same host as API)
# ADMIN_DIST_PATH=../admin/dist

# AI survey analysis (optional)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Maps distance / ETA (optional for mobile; backend uses for supplier routes)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
