# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT — copy to backend/.env
# Database: MongoDB Atlas (same cluster as production is OK for dev)
# API runs on this PC at http://localhost:5000
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/H20online?retryWrites=true&w=majority
JWT_SECRET=your-dev-secret

MASTER_ADMIN_EMAIL=H2O admin
MASTER_ADMIN_PASSWORD=admin@H2O

# Not required when NODE_ENV=development (CORS allows all origins)
# ALLOWED_ORIGINS=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MAPS_API_KEY=

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
