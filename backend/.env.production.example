# ═══════════════════════════════════════════════════════════════════════════
# H2O Online — BACKEND production template (AWS EC2 / Ubuntu)
# ═══════════════════════════════════════════════════════════════════════════
# Copy to backend/.env on the server (NEVER commit backend/.env to GitHub):
#   cp .env.production.example .env
# Then replace every value marked ⚠ CHANGE FOR PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════

# ⚠ CHANGE FOR PRODUCTION — must be "production" on AWS (enables CORS lock, trust proxy, env validation)
NODE_ENV=production

PORT=5000
HOST=0.0.0.0

# ⚠ CHANGE FOR PRODUCTION — MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/H20online?retryWrites=true&w=majority

# ⚠ CHANGE FOR PRODUCTION — generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ⚠ CHANGE FOR PRODUCTION — master admin portal login (not stored in DB)
MASTER_ADMIN_EMAIL=H2O admin
MASTER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ⚠ CHANGE FOR PRODUCTION — comma-separated browser origins (admin SPA URLs)
# Direct EC2 (current):
ALLOWED_ORIGINS=http://13.62.57.255:3000
# With Nginx + domain (recommended later):
# ALLOWED_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com
# If admin is served from same host as API (port 5000 only):
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional: serve built admin from backend (single port 5000) — set path after admin npm run build:prod
# ADMIN_DIST_PATH=../admin/dist

# ⚠ CHANGE FOR PRODUCTION — use live keys when accepting real payments
RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE_RAZORPAY_LIVE_SECRET

# ⚠ CHANGE FOR PRODUCTION — restrict Google Cloud key to server IP + required APIs
GOOGLE_MAPS_API_KEY=REPLACE_GOOGLE_MAPS_KEY

# Optional — AI survey / water insights
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
